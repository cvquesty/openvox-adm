{
  "name": "openvox-adm",
  "version": "0.1.0",
  "author": "OpenVox Project",
  "summary": "Bolt plans for deploying and managing OpenVox infrastructure",
  "license": "Apache-2.0",
  "source": "https://github.com/OpenVoxProject/openvox-adm",
