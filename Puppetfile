# OpenVox Administration Module (openvox-adm) Puppetfile
# Bolt project dependencies

forge 'https://forge.puppet.com'

mod 'puppetlabs/stdlib', '>= 9.0.0 < 10.0.0'
mod 'puppetlabs/node_manager', '>= 1.0.1 < 2.0.0'
mod 'puppet/format', '>= 0.1.0 < 3.0.0'
mod 'puppetlabs/service', '>= 1.3.0 <= 4.0.0'
mod 'puppetlabs/package', '>= 2.1.0 <= 4.0.0'
mod 'puppetlabs/inifile', '>= 6.1.0 < 7.0.0'
mod 'puppetlabs/ruby_task_helper', '>= 1.0.0 < 2.0.0'

# OpenVoxDB module for PuppetDB/OpenVoxDB management
mod 'puppet/openvoxdb', '>= 0.1.0'

# r10k for code deployment
mod 'puppet/r10k', '>= 10.0.0'

# HAProxy for load balancing compilers
mod 'puppetlabs/haproxy', '>= 6.0.0'
